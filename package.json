{
  "name": "zerofeebank",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador bancario de portafolio — sistema bajo prueba automatizable",
  "scripts": {
    "test:domain": "vitest run --dir src/domain",
    "typecheck": "tsc --noEmit",
    "guante": "bash scripts/guante.sh",
    "test:mutation": "stryker run",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop db",
    "verify:s00": "bash scripts/verificar-s00.sh",
    "verify:s04": "bash scripts/verificar-s04.sh",
    "test:concurrencia": "vitest run --config vitest.integracion.config.ts test/concurrencia.int.spec.ts",
    "test:idempotencia": "vitest run --config vitest.integracion.config.ts test/idempotencia.int.spec.ts",
    "test:costuras": "vitest run --config vitest.integracion.config.ts test/costuras.int.spec.ts",
    "test:costuras-credencial": "vitest run --config vitest.integracion.config.ts test/costuras-credenciales.int.spec.ts",
    "test:auth": "vitest run --config vitest.integracion.config.ts test/auth.int.spec.ts",
    "test:cuentas": "vitest run --config vitest.integracion.config.ts test/cuentas.int.spec.ts",
    "test:boletas": "vitest run --config vitest.integracion.config.ts test/boletas.int.spec.ts",
    "test:movimientos": "vitest run --config vitest.integracion.config.ts test/movimientos.int.spec.ts",
    "test:contacto": "vitest run --config vitest.integracion.config.ts test/contacto.int.spec.ts",
    "test:billpay": "vitest run --config vitest.integracion.config.ts test/billpay.int.spec.ts",
    "test:prestamos": "vitest run --config vitest.integracion.config.ts test/prestamos.int.spec.ts",
    "test:reloj": "vitest run --config vitest.integracion.config.ts test/reloj-fechas.int.spec.ts",
    "test:pdf": "vitest run --config vitest.integracion.config.ts test/comprobantes-pdf.int.spec.ts",
    "test:otros-bancos": "vitest run --config vitest.integracion.config.ts test/otros-bancos.int.spec.ts",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "sonda:caja": "bash scripts/sonda-caja.sh",
    "sonda:garantia": "bash scripts/sonda-garantia.sh",
    "demo:m6": "bash scripts/demo-m6.sh",
    "invariantes": "bash scripts/invariantes.sh",
    "invariantes:calibrar": "bash scripts/calibrar-invariantes.sh",
    "verificar:s10-t1": "bash scripts/verificar-s10-t1.sh",
    "verificar:s10-t2": "bash scripts/verificar-s10-t2.sh",
    "verificar:s10-t3": "bash scripts/verificar-s10-t3.sh",
    "verificar:s10-t4": "bash scripts/verificar-s10-t4.sh",
    "verificar:s17-boletas": "bash scripts/verificar-s17-boletas.sh",
    "verificar:s17-abrir-cuenta": "bash scripts/verificar-s17-abrir-cuenta.sh",
    "verificar:s17-transferir": "bash scripts/verificar-s17-transferir.sh",
    "verificar:s17-movimientos": "bash scripts/verificar-s17-movimientos.sh",
    "verificar:s17-pagos": "bash scripts/verificar-s17-pagos.sh",
    "verificar:s17-contacto": "bash scripts/verificar-s17-contacto.sh",
    "verificar:ux-a": "bash scripts/verificar-ux-a.sh",
    "verificar:ux-b1": "bash scripts/verificar-ux-b1.sh",
    "verificar:ux-b2": "bash scripts/verificar-ux-b2.sh"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "playwright-core": "1.60.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.0",
    "unpdf": "1.8.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource/jost": "5.3.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pdfkit": "0.20.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
