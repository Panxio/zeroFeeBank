# Copy to `.env` (cp .env.example .env) before building or running anything.
#
# The database values below are the credentials of the LOCAL development container defined in
# docker-compose.yml. They are published on purpose (see README) and are valid only there.
# Never reuse them, or anything like them, in any other environment.
DATABASE_URL=postgresql://zerofeebank_app:zerofeebank_app_local@localhost:5432/zerofeebank
DATABASE_URL_MIGRACION=postgresql://zerofeebank:zerofeebank_local@localhost:5432/zerofeebank
PORT=3000

# Token signing secret: at least 32 characters, and the app refuses to start without it.
# Left empty on purpose: generate your own, e.g. `openssl rand -hex 32`.
# It is not needed to build, typecheck or run the domain tests.
ZFB_AUTH_SECRET=

# Test seams (/__test__/*). Active only when exactly "1"; any other value means off.
ZFB_COSTURAS_PRUEBA=1
ZFB_ORIGEN_APP=http://localhost:4200
